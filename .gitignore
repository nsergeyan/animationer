# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Pipeline output (generated per run)
output/

# Mood music library: public domain, but ~20 MB of audio does not belong in
# the repo. CREDITS.txt (tracked) lists where to download every file.
assets/music/moods/**/*.mp3
assets/music/moods/**/*.wav
assets/music/moods/**/*.m4a
assets/music/moods/**/*.flac
assets/music/moods/**/*.ogg

# Sound effects: third-party files, licenses unverified, never publish them.
assets/sfx/**/*.mp3
assets/sfx/**/*.wav
assets/sfx/**/*.m4a
assets/sfx/**/*.MP3
assets/sfx/**/*_kept.txt

# Node / Remotion
remotion/node_modules/
remotion/out/

# IDE / OS
.idea/
.DS_Store
.claude/settings.local.json

# flow_runner runtime state (browser profile, generated images, debug shots)
flow_runner/.chrome-profile*/
flow_runner/output/
flow_runner/debug/
flow_runner/scenes.txt

# AI assistant config (kept locally, not part of the public repo)
CLAUDE.md
.claude/

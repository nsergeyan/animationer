# Copy to .env and fill in. Never commit the real .env.

# The only key the pipeline actually needs.
ELEVENLABS_API_KEY=

# Optional. No shipped stage uses it: images come from Google Flow through a
# browser login, not an API key. Only needed if you build the character
# consistency pass (see config.py's CONSISTENCY_MODEL).
GEMINI_API_KEY=

# Comma-separated name:voice_id pairs from your own ElevenLabs account.
# ELEVENLABS_DEFAULT_VOICE picks which one is used when --voice isn't given.
# Example: ELEVENLABS_VOICES=narrator:abc123,sidekick:def456
ELEVENLABS_VOICES=
ELEVENLABS_DEFAULT_VOICE=

# Your own Google Flow project (open labs.google/fx/tools/flow, create/open a
# project, copy the URL from the address bar).
GOOGLE_FLOW_PROJECT_URL=
